{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: full stack (turbopack)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "runtimeArgs": ["--inspect"],
      "skipFiles": ["<node_internals>/**"],
      "sourceMapPathOverrides": {
        "turbopack:///[project]/*": "${workspaceFolder}/*"
      },
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      "name": "Next.js: full stack (webpack)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/next/dist/bin/next",
      "runtimeArgs": ["--inspect"],
      "args": ["dev", "--webpack"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**", "**/.next/**"],
      "smartStep": true,
      "sourceMapPathOverrides": {
        "webpack://_N_E/*": "${workspaceFolder}/*",
        "webpack://_N_E/./*": "${workspaceFolder}/*",
        "webpack:///./*": "${workspaceFolder}/*",
        "/(pages-dir-node)/*": "${workspaceFolder}/*"
      },
      "serverReadyAction": {
        "action": "debugWithChrome",
        "killOnServerStop": true,
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "webRoot": "${workspaceFolder}"
      }
    },
    {
      "name": "Next.js: Launch Server (turbopack)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev --inspect",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Next.js: Attach Server",
      "type": "node",
      "request": "attach",
      "smartStep": true,
      "autoAttachChildProcesses": false,
      "port": 9229,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**", "**/.next/**"],
      "sourceMapPathOverrides": {
        "turbopack:///[project]/*": "${workspaceFolder}/*",
        "webpack://_N_E/*": "${workspaceFolder}/*"
      },
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**",
        "!**/.next/**"
      ]
    },
    {
      "name": "Next.js: Launch Client (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "skipFiles": ["**/node_modules/**", "**/.next/**"],
      "sourceMapPathOverrides": {
        "turbopack:///[project]/*": "${workspaceFolder}/*",
        "webpack://_N_E/*": "${workspaceFolder}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Next.js: Fullstack (Launch+Attach)",
      "configurations": [
        "Next.js: Launch Server (turbopack)",
        "Next.js: Attach Server",
        "Next.js: Launch Client (Chrome)"
      ],
      "stopAll": true
    }
  ]
}
